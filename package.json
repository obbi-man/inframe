{
  "name": "inframe",
  "productName": "InFrame",
  "private": false,
  "version": "1.0.0",
  "description": "Open-source browser helper for editors — insert images and videos into Premiere, After Effects, Resolve, CapCut",
  "license": "MIT",
  "author": "Artem Savinykh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obbi-man/inframe.git"
  },
  "bugs": {
    "url": "https://github.com/obbi-man/inframe/issues"
  },
  "homepage": "https://github.com/obbi-man/inframe#readme",
  "keywords": [
    "davinci-resolve",
    "premiere-pro",
    "after-effects",
    "capcut",
    "video-editing",
    "electron",
    "stock-footage"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
